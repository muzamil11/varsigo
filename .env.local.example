EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_ADMIN_FUNCTION_URL=your_supabase_admin_function_url
EXPO_PUBLIC_DELETE_ACCOUNT_FUNCTION_URL=your_delete_account_function_url
EXPO_PUBLIC_REPORT_REVIEW_FUNCTION_URL=your_report_review_function_url
EXPO_PUBLIC_COMMUNITY_FUNCTION_URL=your_community_function_url
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Web OAuth client ID from Google Cloud Console (the "Web client (auto
# created by Google Service)" one — also found inside google-services.json
# under client[].oauth_client[] where client_type is 3). Required by
# GoogleSignin.configure() even on native, per @react-native-google-signin/
# google-signin's docs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Google account email that unlocks the in-app Admin tab. Leave blank to
# keep the admin panel disabled.
EXPO_PUBLIC_ADMIN_EMAIL=admin@example.com

# Server-only — used by `npm run seed`, never bundled into the app (no
# EXPO_PUBLIC_ prefix). Get it from Supabase Dashboard → Settings → API →
# "service_role" secret key. Never commit a real value or ship it client-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
